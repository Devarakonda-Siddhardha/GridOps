[node name="Content" type="VBoxContainer" parent="Panel/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="HeroSection" type="VBoxContainer" parent="Panel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="HeroTitle" type="Label" parent="Panel/VBox/Scroll/Content/HeroSection"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.75, 0.25, 1)
theme_override_font_sizes/font_size = 17
text = "🏛 HERO: NIKOLAOS OF SPARTA (Lion of Mount Taygetos)"

[node name="HeroBio" type="RichTextLabel" parent="Panel/VBox/Scroll/Content/HeroSection"]
layout_mode = 2
bbcode_enabled = true
fit_content = true
text = "[color=#d8d8d8]Once the revered Polemarch of the Spartan vanguard, [b]Nikolaos[/b] witnessed the legions of Rome storm across Greece, despoiling the sanctuaries of the Gods, burning olive groves, and locking thousands of Greek citizens into iron prisoner cages. Left for dead on the slopes of Mount Taygetos, Nikolaos was chosen by [b]Pallas Athena[/b] to receive the sacred aegis and divine favor of Mount Olympus.

[color=#ffd700]Starting as a lone wanderer[/color], Nikolaos has sworn a blood-oath to liberate his enslaved countrymen across a 10-chapter campaign, assemble an invincible Greek Phalanx of Hoplites, Cretan Archers, and Thessalian Cavalry, cross the Adriatic Sea, and lay siege to Rome itself to overthrow the tyrannical Roman Consul Titus Claudius![/color]"

[node name="ControlsSection" type="VBoxContainer" parent="Panel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="ControlsTitle" type="Label" parent="Panel/VBox/Scroll/Content/ControlsSection"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.85, 1.0, 1)
theme_override_font_sizes/font_size = 17
text = "⚔ COMBAT & MOVEMENT CONTROLS"

[node name="ControlsText" type="RichTextLabel" parent="Panel/VBox/Scroll/Content/ControlsSection"]
layout_mode = 2
bbcode_enabled = true
fit_content = true
text = "[b]WASD[/b]: Move in full 3D  |  [b]Left Click / J[/b]: Attack Combo / Lance Thrust / Arrow
[b]SPACEBAR[/b]: [color=#55ff55]Vertical Jump[/color] (Vault over obstacles, rocks, steps, and barricades)
[b]SHIFT / ALT / K[/b]: [color=#55ffff]Directional Dodge Roll[/color] (Invulnerable dash in movement direction)
[b]TAB / T[/b]: [color=#ffbb44]Cycle Hero Class[/color] (Spartan Champion, Cretan Archer, Thessalian Cavalry)
[b]E[/b]: Pray at Deity Altars to commune with the Gods and unlock permanent divine powers
[b]B / P[/b]: Open this Hellenic Codex & Lore Archive"

[node name="ArmySection" type="VBoxContainer" parent="Panel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="ArmyTitle" type="Label" parent="Panel/VBox/Scroll/Content/ArmySection"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.9, 0.5, 1)
theme_override_font_sizes/font_size = 17
text = "🛡 GREEK PHALANX ORDERS (Command Your Army)"

[node name="ArmyText" type="RichTextLabel" parent="Panel/VBox/Scroll/Content/ArmySection"]
layout_mode = 2
bbcode_enabled = true
fit_content = true
text = "Smash Roman cages throughout chapters to recruit freed Greek soldiers into your personal army!
• [b][G] ARMY CHARGE[/b]: Commands all allied Hoplites to break ranks and aggressively rush enemy lines.
• [b][H] SHIELD WALL[/b]: Locks shields in phalanx formation. Hoplites gain [b]65% damage reduction[/b] and absorb incoming projectile/melee blows!
• [b][V] REGROUP / RALLY[/b]: Recalls all soldiers immediately back to Nikolaos's side in defensive formation."

[node name="CampaignSection" type="VBoxContainer" parent="Panel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="CampaignTitle" type="Label" parent="Panel/VBox/Scroll/Content/CampaignSection"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.6, 0.3, 1)
theme_override_font_sizes/font_size = 17
text = "🗺 10-CHAPTER CAMPAIGN ROADMAP"

[node name="CampaignText" type="RichTextLabel" parent="Panel/VBox/Scroll/Content/CampaignSection"]
layout_mode = 2
bbcode_enabled = true
fit_content = true
text = "[b]Chapter 1: Sanctuary of Mount Olympus[/b] — Receive divine blessings from Zeus, Poseidon, Hades, Ares, and Athena.
[b]Chapter 2: Coast of Nauplia[/b] — Repel the Roman beachhead landing force and burn their triremes.
[b]Chapter 3: Valley of Arcadia[/b] — Liberate captured Spartan hoplites from Roman cages and form your Phalanx.
[b]Chapter 4: Chasm of Tartarus[/b] — Cleanse the underworld demonic rift and slay the Infernal Minotaur.
[b]Chapter 5: Fortress of Corinth[/b] — Breach the castrum gate and defeat Legatus General Marcus Aurelius.
[b]Chapter 6: Pass of Thermopylae[/b] — Hold the Hot Gates against Roman ballistas and legionary waves.
[b]Chapter 7: Oracle of Delphi[/b] — Purge the defilers from Apollo's shrine and unlock the Golden Aegis.
[b]Chapter 8: Isle of Delos[/b] — Free Cretan archers and Thessalian cavalry, seizing the Roman naval armada.
[b]Chapter 9: The Appian Way[/b] — Invade Italy! Smash Roman siege camps, catapults, and military tents.
[b]Chapter 10: Siege of Rome & Imperial Colosseum[/b] — Breach Rome, defeat Consul Titus Claudius, and restore the Greek Empire!"
