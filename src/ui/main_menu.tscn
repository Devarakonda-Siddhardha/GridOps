[node name="HeroSection" type="Label" parent="CodexModal/Panel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)
theme_override_font_sizes/font_size = 18
text = "⚔ NIKOLAOS OF SPARTA — THE LION OF MOUNT TAYGETOS"

[node name="HeroText" type="Label" parent="CodexModal/Panel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.88, 0.95, 1)
theme_override_font_sizes/font_size = 14
text = "A direct descendant of King Leonidas I, Nikolaos once served as Polemarch of the Spartan army. When Roman legions swept across Greece, despoiling temples and chaining citizens in iron cages, Nikolaos swore an oath to rise from solitary exile, liberate his countrymen, assemble the unbreakable Greek Phalanx, and march to Rome to defeat Consul Titus Claudius."
autowrap_mode = 3

[node name="GodsSection" type="Label" parent="CodexModal/Panel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.8, 1, 1)
theme_override_font_sizes/font_size = 18
text = "⚡ THE OLYMPIAN PANTHEON & DIVINE POWERS"

[node name="GodsText" type="Label" parent="CodexModal/Panel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.88, 0.95, 1)
theme_override_font_sizes/font_size = 14
text = "• ZEUS [1 / Q]: Wrath of Olympus — Calls down celestial thunderbolts to disintegrate approaching legions.
• POSEIDON [2 / F]: Tidal Surge — Summons an oceanic crest that knocks back and stuns enemies.
• HADES [3 / R]: Abyssal Siphon — Drains enemy soul vitality to restore health and stamina.
• ARES [4 / C]: Spartan Berserk — Ignites warrior bloodlust, granting +220% melee damage boost."
autowrap_mode = 3

[node name="PhalanxSection" type="Label" parent="CodexModal/Panel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.6, 0.2, 1)
theme_override_font_sizes/font_size = 18
text = "🛡️ GREEK PHALANX TACTICAL COMMANDS"

[node name="PhalanxText" type="Label" parent="CodexModal/Panel/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.88, 0.95, 1)
theme_override_font_sizes/font_size = 14
text = "• [G] CHARGE: Commands your rescued hoplites, archers, and cavalry to charge forward.
• [H] SHIELD WALL: Hoplites lock bronze shields in dense formation, gaining 65% damage reduction!
• [V] REGROUP: Immediately orders all allied soldiers to fall back to Nikolaos in defensive perimeter."
autowrap_mode = 3

