; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="Pantheon's Wrath: Champions of Hellas"
config/description="3D Greek Action Combat game with Olympian blessings and Tartarus demons"
run/main_scene="res://src/levels/level1_sanctuary.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

SoundManager="*res://src/audio/sound_manager.gd"
DivineManager="*res://src/powers/divine_manager.gd"
CampaignManager="*res://src/campaign/campaign_manager.gd"
AthenaCommentary="*res://src/campaign/athena_commentary.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.08, 0.12, 1)

[input]

